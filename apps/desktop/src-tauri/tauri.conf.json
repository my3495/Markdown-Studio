{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Markdown Studio",
  "version": "1.0.6",
  "identifier": "com.mdstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws:; img-src 'self' asset: https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "http://127.0.0.1:8788/latest.json"
      ],
      "dialog": false,
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5REM2NkQ4MjIxMzJDNTkKUldSWkxCTWkyR2JjMmNacStUQ1pMaGVhZnhEYVhmKzVwWWI4TDk2SUREemk0VnpOK3BjcUc0MTQK"
    }
  }
}
